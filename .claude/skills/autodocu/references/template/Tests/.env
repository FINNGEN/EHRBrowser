# AUTODOCU test harness settings.
#
# run_test.sh sources this file (it sits next to run_test.sh) before a run.
# The autodocu skill ships this default .env in its template and `init` copies
# it here. Edit the values below to tune a run. This is the single place for the
# generic harness knobs — nothing app-specific lives here (that is
# Scripts/app_control.sh: APP_URL, start_app, stop_app).

# Percent of changed pixels above which a freshly captured screenshot counts as
# CHANGED. (A colour channel must differ by more than 16/255 for a pixel to
# count as changed at all — that ignores invisible sub-pixel anti-aliasing
# wobble; see Scripts/compare_report.mjs PIXEL_DELTA_TOLERANCE.)
#   diff  > threshold  -> committed image is REPLACED, screenshot row = FAIL
#   diff <= threshold  -> committed image is KEPT,     screenshot row = PASS
AUTODOCU_DIFF_THRESHOLD=1

# --- Set automatically by run_test.sh; listed here for reference only. Leave
# --- them unset so the runner can point them at per-run temp files. ----------
# AUTODOCU_SHOT_ROOT           where the specs (Scripts/playwright/_helpers.ts)
#                              write screenshots — a temp dir during a run; when
#                              unset it falls back to AUTODOCU/Documentation.
# PLAYWRIGHT_JSON_OUTPUT_NAME  where Playwright writes its JSON result report,
#                              which Scripts/compare_report.mjs reads for pass/fail.
