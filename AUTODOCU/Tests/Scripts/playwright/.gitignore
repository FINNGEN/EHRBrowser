# AUTODOCU/Tests/Scripts/playwright — the self-contained Playwright workspace.
#
# Committed SOURCES (here): package.json, package-lock.json,
# playwright.config.ts, _helpers.ts, .gitignore.
# (The specs live two levels up in AUTODOCU/Tests/<section>/; the folder
# README is AUTODOCU/Tests/README.md.)
#
# Everything below is installed or regenerated on each run — never commit it.

# installed dependencies (@playwright/test etc.)
node_modules/

# Playwright test outputDir scratch (e.g. .last-run.json)
.pw-artifacts/

# dumps from the interactive playwright-cli selector tool
.playwright-cli/

# misc Playwright scratch
.playwright/

# default Playwright results / report dirs (if ever produced)
test-results/
playwright-report/
